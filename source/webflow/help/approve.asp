<body bgcolor="#FFFFFF">
<table width="100%" border="0" cellspacing="1" cellpadding="2">
  <tr> 
    <td align="center" width="1%"><img src="/sys/imgs/quest_paper.gif" width="14" height="17"></td>
    <td><font class="pagetitle">หน้าจอ Approve/Reject status</font></td>
  </tr>
  <tr> 
    <td align="center" width="1%">&nbsp;</td>
    <td>หน้าจอ<font class="pagetitle"> Approve/Reject status</font> แสดงรายการที่ท่านได้อนุมัติหรือยกเลิก<br>
      ท่านสามารถดูรายละเอียดของแบบฟอร์มได้โดยการคลิ๊กที่คอลัมน์ &quot;Form&quot; 
      ในบรรทัดที่ท่านต้องการ<br>
      ความหมายของแต่ละคอลัมน์มีดังนี้</td>
  </tr>
  <tr valign="top"> 
    <td align="center" colspan="2"><img src="/sys/imgs/spacer.gif" height="4"></td>
  </tr>
  <tr> 
    <td align="center" width="1%">&nbsp;</td>
    <td> 
      <table width="100%" border="0" cellspacing="0" cellpadding="0">
        <tr> 
          <td> 
            <table width="100%" border="0" cellspacing="1" cellpadding="2">
              <tr bgcolor="#FFFFFF"> 
                <td><font color="#000000"></font></td>
                <td nowrap bgcolor="#FFFFFF"><font color="#000000"><b>Column</b></font></td>
                <td width="100%" bgcolor="#FFFFFF"><font color="#000000"><b>Description</b></font></td>
              </tr>
              <tr bgcolor="#FFFFFF"> 
                <td><font color="#000000"><img src="/form/imgs/handpointer.gif" width="18" height="18"></font></td>
                <td nowrap>No</td>
                <td>ลำดับรายการ (ไม่มีความหมาย)</td>
              </tr>
              <tr bgcolor="#FFFFFF" valign="top"> 
                <td><font color="#000000"><img src="/form/imgs/handpointer.gif" width="18" height="18"></font></td>
                <td nowrap>Flow status</td>
                <td>รูปแสดงสถานะรายการ (โฟล์) ดังนี้ 
                  <table width="100%" border="0" cellspacing="1" cellpadding="2">
                    <tr> 
                      <td width="1%"><img src="/form/imgs/flowstatus/run.gif"></td>
                      <td>กำลังดำเนินการ</td>
                    </tr>
                    <tr> 
                      <td width="1%"><img src="/form/imgs/flowstatus/approve.gif"></td>
                      <td>รายการได้รับการอนุมัติ</td>
                    </tr>
                    <tr> 
                      <td width="1%"><img src="/form/imgs/flowstatus/reject.gif"></td>
                      <td>รายการถูกยกเลิก</td>
                    </tr>
                  </table>
                </td>
              </tr>
              <tr bgcolor="#FFFFFF"> 
                <td><font color="#000000"><img src="/form/imgs/handpointer.gif" width="18" height="18"></font></td>
                <td nowrap>Form</td>
                <td>รหัสฟอร์ม (ชื่อย่อตามด้วยลำดับรายการนับรวมกันทุกแผนก)</td>
              </tr>
              <tr bgcolor="#FFFFFF"> 
                <td><font color="#000000"><img src="/form/imgs/handpointer.gif" width="18" height="18"></font></td>
                <td nowrap>Key</td>
                <td>รหัสและชื่อผู้กรอกแบบฟอร์ม</td>
              </tr>
              <tr bgcolor="#FFFFFF"> 
                <td><font color="#000000"><img src="/form/imgs/handpointer.gif" width="18" height="18"></font></td>
                <td nowrap>Requester</td>
                <td>รหัสและชื่อผู้ขอ</td>
              </tr>
              <tr bgcolor="#FFFFFF"> 
                <td><font color="#000000"><img src="/form/imgs/handpointer.gif" width="18" height="18"></font></td>
                <td nowrap>Request date</td>
                <td>วันที่สร้างรายการ</td>
              </tr>
              <tr bgcolor="#FFFFFF"> 
                <td><font color="#000000"><img src="/form/imgs/handpointer.gif" width="18" height="18"></font></td>
                <td nowrap><font color="#000000">Request time</font></td>
                <td>เวลาที่สร้างรายการ</td>
              </tr>
            </table>
          </td>
        </tr>
      </table>
    </td>
  </tr>
  <tr valign="top"> 
    <td align="center" colspan="2"><img src="/sys/imgs/spacer.gif" height="4"></td>
  </tr>
  <tr valign="top"> 
    <td align="center" width="1%"><font color="#FF0000"><img src="/sys/imgs/exclam.gif"></font></td>
    <td><font color="#FF0000">ในหน้าจอ Approve/Reject status จะไม่แสดงรายการที่ท่านเป็นผู้ขอหรือกรอกแบบฟอร์มขอให้กับผู้อื่นนอกจาก<br>
      ท่านเป็นหนึ่งในผู้ที่มีหน้าที่พิจารณาอนุมัติหรือยกเลิกรายการในขึ้นตอนอื่นนอกเหนือจากขั้นตอนแรก 
      (Requester)</font></td>
  </tr>
</table>
